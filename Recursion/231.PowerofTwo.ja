class Solution {
    public boolean isPowerOfTwo(int n) {
        if (n <= 0) {
            return false;
        }
        
        long nm = 1; 
        for (int i = 0; i <= 30; i++) { 
            if (nm == n) {
                return true;
            }
            nm *= 2; 
        }
        
        return false;
    }
}
